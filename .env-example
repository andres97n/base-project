API_SUB_PATH=api
PORT=3000
NODE_ENV=dev
DEFAULT_PAGE_SIZE=10
CORS_ORIGIN=*

# Database type: mongodb | postgres (default: mongodb)
DB_TYPE=mongodb

# MongoDB (required when DB_TYPE=mongodb)
DB_URI=[DB_PATH_CONNECTION] mongodb://localhost:27017/bd

# PostgreSQL (required when DB_TYPE=postgres)
# Option A: connection URL (takes precedence over individual fields)
POSTGRES_URI=postgresql://user:password@localhost:5432/dbname
# Option B: individual connection fields
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dbname
POSTGRES_USER=user
POSTGRES_PASSWORD=password

JWT_SECRET=SECRET_PHRASE
JWT_TIME=2h
JWT_REFRESH_TIME=7d
JWT_REFRESH_SECRET=ANOTHER_SECRET_PHRASE

ENABLE_CACHE=true
CACHE_EXPIRED_TIME=300000

# Logging
LOG_LEVEL=info

# Outbound HTTP client (external API calls)
HTTP_TIMEOUT=5000
HTTP_MAX_REDIRECTS=5
HTTP_RETRY_ATTEMPTS=3
HTTP_RETRY_BASE_DELAY=300

# Seed (run with: pnpm seed)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=Admin1234!
# SEED_ADMIN_FULL_NAME=Admin
